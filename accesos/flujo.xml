<?xml version="1.0" encoding="UTF-8"?>
<ChecklistAccesos marca="Neibora" titulo="Registro de caseta" version="2" vigilante="Vigilante Demo">
  <Descripcion><p>Prototipo con registros ficticios. Una pregunta a la vez; no realiza comunicaciones ni abre accesos.</p></Descripcion>
  <Grupo nombre="Inicio">
    <Campo tipo="opcion" etiqueta="¿Qué necesitas registrar?" name="operacion" obligatorio="true">
      <Opcion valor="entrada" icono="↘" detalle="Personas, vehículos y destinos">Entrada</Opcion>
      <Opcion valor="salida" icono="↗" detalle="Localizar un ingreso y registrar su salida">Salida</Opcion>
      <Opcion valor="llamada" icono="◉" detalle="Simular contacto y solicitar autorización">Llamada / solicitar autorización</Opcion>
      <Opcion valor="objetos" icono="▣" detalle="Resguardo, entrega y devolución">Recibir / entregar objetos</Opcion>
      <Opcion valor="emergencia" icono="✚" detalle="Atención prioritaria o visita ordinaria">Servicios de emergencia</Opcion>
      <Opcion valor="lista" icono="☷" detalle="Ingresos, objetos y tags por recuperar">Personas dentro / pendientes</Opcion>
    </Campo>
  </Grupo>
  <Grupo nombre="Captura inicial" condicion_necesita_identificacion="Sí">
    <Campo tipo="captura" etiqueta="Identificación y placa, antes de anunciar" name="captura_inicial" obligatorio="true" omitir_existente="personas.nombre"/>
    <Descripcion><p>Nombre desde la identificación y placas desde el vehículo. Lectura simulada o captura manual; revisa los datos antes de usarlos. No se guardan imágenes de identificaciones.</p></Descripcion>
  </Grupo>
  <Grupo nombre="Localizar ingreso" condicion_operacion="salida">
    <Campo tipo="referencia" catalogo="ingresos" etiqueta="Busca por persona, placas o tag" name="ingreso_id" obligatorio="true" accion="recuperar_ingreso" invalida="personas_salen vehiculo_sale devolvio_tag"/>
    <Campo tipo="texto" etiqueta="Nombre de la persona que sale" name="nombre_salida" condicion_ingreso_id="sin_ingreso" obligatorio="true"/>
    <Campo tipo="texto" etiqueta="Incidencia: no se encontró el ingreso" name="incidencia_sin_ingreso" condicion_ingreso_id="sin_ingreso" obligatorio="true"/>
    <Campo tipo="texto" etiqueta="Placas, si salen en vehículo (opcional)" name="placas_salida" condicion_ingreso_id="sin_ingreso"/>
    <Campo tipo="opcion" etiqueta="¿Qué salida registras?" name="tipo_salida" obligatorio="true" invalida="autorizaciones.resultado documentos.verificado">
      <Opcion>Salida normal</Opcion><Opcion>Salida de muebles</Opcion><Opcion>Retiro de vehículo</Opcion><Opcion>Otro movimiento</Opcion>
    </Campo>
    <Campo tipo="texto" etiqueta="Describe el movimiento especial" name="detalle_salida" condicion_tipo_salida="Otro movimiento" obligatorio="true"/>
  </Grupo>
  <Grupo nombre="Objetos" condicion_operacion="objetos">
    <Campo tipo="opcion" etiqueta="¿Qué movimiento?" name="movimiento_objeto" obligatorio="true" invalida="objeto_id objeto_recuperado tipo_objeto descripcion_objeto cantidad_objeto referencia_objeto entrega_nombre recibe_nombre receptor_verificado destinos">
      <Opcion>Recibir en caseta</Opcion><Opcion>Entregar desde caseta</Opcion><Opcion>Devolución</Opcion>
    </Campo>
    <Campo tipo="referencia" catalogo="objetos" etiqueta="Busca el objeto en resguardo" name="objeto_id" obligatorio="true" condicion_movimiento_objeto="Entregar desde caseta|Devolución" accion="recuperar_objeto" invalida="recibe_nombre receptor_verificado"/>
    <Campo tipo="opcion" etiqueta="¿Qué objeto recibes?" name="tipo_objeto" condicion_movimiento_objeto="Recibir en caseta" obligatorio="true">
      <Opcion>Tag</Opcion><Opcion>Llaves</Opcion><Opcion>Paquete</Opcion><Opcion>Mercancía</Opcion><Opcion>Documento</Opcion><Opcion>Otro</Opcion>
    </Campo>
    <Campo tipo="texto" etiqueta="Descripción del objeto" name="descripcion_objeto" condicion_movimiento_objeto="Recibir en caseta" obligatorio="true"/>
    <Campo tipo="numero" etiqueta="Cantidad recibida" name="cantidad_objeto" min="1" condicion_movimiento_objeto="Recibir en caseta" obligatorio="true"/>
    <Campo tipo="texto" etiqueta="Referencia, número o guía" name="referencia_objeto" condicion_movimiento_objeto="Recibir en caseta"/>
    <Campo tipo="texto" etiqueta="¿Quién entrega?" name="entrega_nombre" condicion_movimiento_objeto="Recibir en caseta" obligatorio="true"/>
    <Campo tipo="texto" etiqueta="¿Quién recibe? (vigilante o destinatario)" name="recibe_nombre" obligatorio="true"/>
    <Campo tipo="si_no" etiqueta="¿Verificaste la identidad y relación del receptor con el destino?" name="receptor_verificado" condicion_movimiento_objeto="Entregar desde caseta|Devolución" obligatorio="true"/>
  </Grupo>
  <Grupo nombre="Servicio" condicion_operacion="emergencia">
    <Campo tipo="opcion" etiqueta="¿Qué servicio atiendes?" name="servicio" obligatorio="true"><Opcion>Policía</Opcion><Opcion>Bomberos</Opcion><Opcion>Ambulancia</Opcion><Opcion>Protección Civil</Opcion><Opcion>Otro</Opcion></Campo>
    <Campo tipo="texto" etiqueta="Describe el servicio" name="servicio_otro" condicion_servicio="Otro" obligatorio="true"/>
    <Campo tipo="si_no" etiqueta="¿Emergencia activa?" name="emergencia_activa" obligatorio="true"/>
    <Aviso condicion_emergencia_activa="Sí" clase="warn"><p>Aplica el protocolo del coto. Registra servicio, ubicación conocida y hora sin retrasar la atención. Este registro no sustituye el protocolo acordado con administración.</p></Aviso>
    <Campo tipo="si_no" etiqueta="¿Conoces la ubicación exacta?" name="ubicacion_conocida" condicion_emergencia_activa="Sí" obligatorio="true"/>
    <Campo tipo="texto" etiqueta="Ubicación conocida / referencia disponible" name="ubicacion_aproximada" condicion_ubicacion_conocida="No" obligatorio="true"/>
  </Grupo>
  <Grupo nombre="Quién viene" condicion_ordinario="Sí" condicion_operacion="entrada|emergencia">
    <Campo tipo="opcion" etiqueta="¿Quién viene?" name="tipo_persona" obligatorio="true">
      <Opcion>Visita</Opcion><Opcion>Proveedor / trabajador</Opcion><Opcion>Repartidor / paquetería</Opcion><Opcion>Residente</Opcion><Opcion>Administración / personal del coto</Opcion><Opcion>Inmobiliaria / asesor / prospecto</Opcion><Opcion>Autoridad</Opcion><Opcion>Otro</Opcion>
    </Campo>
    <Campo tipo="texto" etiqueta="Describe el tipo de persona" name="tipo_persona_otro" condicion_tipo_persona="Otro" obligatorio="true"/>
  </Grupo>
  <Grupo nombre="Asunto" condicion_ordinario="Sí" condicion_operacion="entrada|llamada|emergencia">
    <Campo tipo="opcion" etiqueta="¿Cuál es el asunto?" name="asunto" obligatorio="true" invalida="autorizaciones.resultado documentos.verificado">
      <Opcion>Visita personal</Opcion><Opcion>Trabajos / mantenimiento / instalación</Opcion><Opcion>Limpieza / jardinería</Opcion><Opcion>Paquetería</Opcion><Opcion>Alimentos / agua / despensa / otros suministros</Opcion><Opcion>Movimiento de muebles</Opcion><Opcion>Movimiento de vehículos</Opcion><Opcion>Mostrar / revisar inmueble</Opcion><Opcion>Servicios públicos / telecomunicaciones</Opcion><Opcion>Acceso de residente / personal</Opcion><Opcion>Diligencia de autoridad</Opcion><Opcion>Otro</Opcion>
    </Campo>
    <Campo tipo="opcion" etiqueta="¿Qué movimiento de muebles?" name="movimiento_muebles" condicion_asunto="Movimiento de muebles" obligatorio="true" invalida="autorizaciones.resultado documentos.verificado"><Opcion>Entrada</Opcion><Opcion>Salida</Opcion><Opcion>Entrada y salida</Opcion></Campo>
    <Campo tipo="opcion" etiqueta="¿Qué movimiento de vehículo?" name="movimiento_vehiculo" condicion_asunto="Movimiento de vehículos" obligatorio="true"><Opcion>Entrega</Opcion><Opcion>Retiro</Opcion><Opcion>Servicio</Opcion></Campo>
    <Campo tipo="opcion" etiqueta="¿Qué servicio público?" name="trabajo_servicio" condicion_asunto="Servicios públicos / telecomunicaciones" obligatorio="true"><Opcion>Conexión</Opcion><Opcion>Desconexión</Opcion><Opcion>Reconexión</Opcion><Opcion>Reparación</Opcion></Campo>
    <Campo tipo="texto" etiqueta="Describe el asunto" name="detalle_asunto" condicion_asunto="Otro" obligatorio="true"/>
    <Campo tipo="texto" etiqueta="Persona o referencia a contactar (opcional)" name="contacto_referencia" condicion_operacion="llamada"/>
  </Grupo>
  <Grupo nombre="Destinos" name="destinos" selector="jerarquico" repetible="true" minimo="1" maximo="20" condicion_necesita_destinos="Sí" etiqueta_agregar="Seleccionar destinos" etiqueta_listo="Continuar">
    <Campo tipo="opcion" etiqueta="¿Qué coto?" name="coto" obligatorio="true" invalida="calle domicilio detalle_destino"><Opcion>Asturias</Opcion><Opcion>Cantabria</Opcion><Opcion>Galicia</Opcion><Opcion>Andalucía</Opcion></Campo>
    <Campo tipo="opcion" etiqueta="¿Qué lugar?" etiqueta_salida="¿De dónde sale?" etiqueta_objetos="¿A qué destino corresponde?" name="tipo_destino" obligatorio="true">
      <Opcion>Domicilio</Opcion><Opcion>Toda la calle</Opcion><Opcion>Gimnasio</Opcion><Opcion>Casa club</Opcion><Opcion>Jardines</Opcion><Opcion>Alberca</Opcion><Opcion>Caseta</Opcion><Opcion>Áreas comunes</Opcion><Opcion>Todo este coto</Opcion>
    </Campo>
    <Campo tipo="catalogo" catalogo="calles" filtro="coto" etiqueta="¿Qué calle?" name="calle" condicion_tipo_destino="Domicilio|Toda la calle" invalida="domicilio"/>
    <Campo tipo="catalogo" catalogo="domicilios" filtro="coto calle" etiqueta="¿Qué números?" name="domicilio" condicion_tipo_destino="Domicilio" obligatorio="true"/>
    <Campo tipo="texto" etiqueta="Detalle de ubicación (opcional)" name="detalle_destino" condicion_tipo_destino="!Domicilio"/>
    <Aviso condicion_tipo_destino="Todo este coto"><p>Este alcance cubre solo el coto seleccionado y requiere respaldo verificado de su administración.</p></Aviso>
  </Grupo>
  <Grupo nombre="Personas" name="personas" repetible="true" minimo="1" maximo="30" condicion_necesita_identificacion="Sí" etiqueta_agregar="Agregar acompañante" etiqueta_listo="Personas listas">
    <Campo tipo="texto" etiqueta="Nombre completo" name="nombre" obligatorio="true" omitir_captura="true"/>
    <Campo tipo="texto" etiqueta="Empresa (si corresponde)" name="empresa" condicion_tipo_persona="Proveedor / trabajador|Repartidor / paquetería|Administración / personal del coto|Inmobiliaria / asesor / prospecto"/>
    <Campo tipo="opcion" etiqueta="¿Qué identificación presenta?" name="identificacion" obligatorio="true" omitir_captura="true"><Opcion>INE</Opcion><Opcion>Licencia</Opcion><Opcion>Pasaporte</Opcion><Opcion>Credencial institucional</Opcion><Opcion>Otra</Opcion><Opcion>No presenta</Opcion></Campo>
    <Campo tipo="si_no" etiqueta="¿Verificaste visualmente la identificación?" name="identificacion_verificada" condicion_identificacion="!No presenta" obligatorio="true"/>
    <Campo tipo="texto" etiqueta="Excepción por falta de identificación" name="excepcion_identificacion" condicion_identificacion="No presenta" obligatorio="true"/>
    <Campo tipo="texto" etiqueta="Relación con la vivienda seleccionada" name="relacion_residente" condicion_tipo_persona="Residente" obligatorio="true"/>
    <Campo tipo="si_no" etiqueta="¿Verificaste la relación del residente con la vivienda?" name="residente_verificado" condicion_tipo_persona="Residente" obligatorio="true"/>
    <Campo tipo="opcion" etiqueta="Estado de su tag de residente" name="tag_residente" condicion_tipo_persona="Residente" obligatorio="true"><Opcion>Disponible</Opcion><Opcion>Sin tag</Opcion><Opcion>Averiado</Opcion></Campo>
    <Descripcion><p>Solo revisión visual; no se solicita fotografía, copia ni retención de identificación.</p></Descripcion>
  </Grupo>
  <Grupo nombre="Vehículo" condicion_necesita_identificacion="Sí">
    <Campo tipo="opcion" etiqueta="¿Cómo ingresa?" name="medio_ingreso" obligatorio="true" omitir_captura="true"><Opcion>A pie</Opcion><Opcion>Bicicleta</Opcion><Opcion>Moto</Opcion><Opcion>Automóvil</Opcion><Opcion>Vehículo de carga</Opcion></Campo>
    <Campo tipo="si_no" etiqueta="¿Tiene placas?" name="tiene_placas" condicion_medio_ingreso="Moto|Automóvil|Vehículo de carga" obligatorio="true" omitir_captura="true"/>
    <Campo tipo="texto" etiqueta="Placas" name="placas" condicion_medio_ingreso="Moto|Automóvil|Vehículo de carga" condicion_tiene_placas="Sí" obligatorio="true" omitir_captura="true"/>
    <Campo tipo="texto" etiqueta="Motivo de vehículo sin placas" name="motivo_sin_placas" condicion_medio_ingreso="Moto|Automóvil|Vehículo de carga" condicion_tiene_placas="No" obligatorio="true"/>
    <Campo tipo="texto" etiqueta="Descripción del vehículo" name="descripcion_vehiculo" condicion_medio_ingreso="Moto|Automóvil|Vehículo de carga" obligatorio="true"/>
  </Grupo>
  <Grupo nombre="Autorizaciones" name="autorizaciones" repetible="true" minimo="1" maximo="20" condicion_necesita_autorizacion="Sí" etiqueta_agregar="Agregar respaldo" etiqueta_listo="Autorizaciones listas">
    <Campo tipo="checklist" catalogo="destinos" etiqueta="¿Qué destinos cubre explícitamente este respaldo?" name="alcance" obligatorio="true" invalida="resultado verificado"/>
    <Campo tipo="opcion" etiqueta="¿Qué respalda el movimiento?" name="respaldo" obligatorio="true" invalida="resultado verificado">
      <Opcion>Formato</Opcion><Opcion>Residente</Opcion><Opcion>Administración del coto</Opcion><Opcion>Titular de la vivienda</Opcion>
    </Campo>
    <Campo tipo="texto" etiqueta="Nombre de quien autoriza, emite o firma" name="autoriza_nombre" obligatorio="true" invalida="resultado verificado"/>
    <Campo tipo="texto" etiqueta="Relación con el domicilio" name="relacion_residente" condicion_respaldo="Residente" obligatorio="true"/>
    <Campo tipo="opcion" etiqueta="Relación con la vivienda" name="relacion_titular" condicion_respaldo="Titular de la vivienda" obligatorio="true"><Opcion>Propietario</Opcion><Opcion>Administrador de la vivienda</Opcion><Opcion>Apoderado</Opcion><Opcion>Otro</Opcion></Campo>
    <Campo tipo="texto" etiqueta="Describe la relación" name="relacion_otro" condicion_relacion_titular="Otro" obligatorio="true"/>
    <Campo tipo="opcion" etiqueta="¿De qué coto es la administración?" name="coto_admin" condicion_respaldo="Administración del coto" obligatorio="true"><Opcion>Asturias</Opcion><Opcion>Cantabria</Opcion><Opcion>Galicia</Opcion><Opcion>Andalucía</Opcion></Campo>
    <Campo tipo="texto" etiqueta="Folio (o adjunta un archivo en la siguiente pregunta)" name="folio" condicion_respaldo="Formato"/>
    <Campo tipo="archivo" etiqueta="Documento de respaldo (opcional si hay folio)" name="documento" condicion_respaldo="Formato"/>
    <Campo tipo="opcion" etiqueta="Canal del contacto o verificación" name="canal" obligatorio="true"><Opcion>Llamada</Opcion><Opcion>WhatsApp</Opcion><Opcion>Presencial</Opcion><Opcion>Documento</Opcion><Opcion>Autorización previa</Opcion></Campo>
    <Campo tipo="si_no" etiqueta="¿Verificaste el respaldo para estos destinos y este movimiento?" name="verificado" obligatorio="true"/>
    <Campo tipo="opcion" etiqueta="Resultado del contacto" name="resultado" obligatorio="true"><Opcion>Autorizado</Opcion><Opcion>No autorizado</Opcion><Opcion>No contesta</Opcion><Opcion>Pendiente de verificar</Opcion></Campo>
    <Descripcion><p>El canal solo se registra. No se hacen llamadas ni envíos reales. Un documento adjunto no equivale a una autorización verificada.</p></Descripcion>
  </Grupo>
  <Grupo nombre="Formato de salida de muebles" name="documentos" repetible="true" minimo="0" maximo="20" condicion_requiere_muebles="Sí" etiqueta_agregar="Agregar formato" etiqueta_listo="Formatos listos">
    <Aviso clase="warn"><p>Solicita y verifica el formato de salida de muebles. Residente, Administración o Titular no sustituyen este requisito. Sin formato, guarda pendiente o registra los hechos como incidencia.</p></Aviso>
    <Campo tipo="checklist" catalogo="origenes" etiqueta="Domicilios de origen cubiertos por el formato" name="alcance" obligatorio="true" invalida="verificado"/>
    <Campo tipo="texto" etiqueta="Folio de salida de muebles (o adjunta documento)" name="folio"/>
    <Campo tipo="archivo" etiqueta="Formato de salida (no adjuntar de nuevo si ya existe)" name="documento"/>
    <Campo tipo="texto" etiqueta="Persona que autoriza el movimiento" name="autoriza_nombre" obligatorio="true"/>
    <Campo tipo="texto" etiqueta="Descripción del movimiento de muebles" name="descripcion" obligatorio="true"/>
    <Campo tipo="si_no" etiqueta="¿El formato corresponde al domicilio y movimiento y fue verificado?" name="verificado" obligatorio="true"/>
  </Grupo>
  <Grupo nombre="Tag temporal" condicion_necesita_identificacion="Sí">
    <Campo tipo="si_no" etiqueta="¿Se entrega un tag temporal?" name="entrega_tag" obligatorio="true"/>
    <Campo tipo="catalogo" catalogo="tags" etiqueta="Selecciona un tag disponible" name="numero_tag" condicion_entrega_tag="Sí" obligatorio="true"/>
    <Campo tipo="catalogo" catalogo="personas" etiqueta="Responsable del préstamo temporal" name="responsable_tag" condicion_entrega_tag="Sí" obligatorio="true"/>
    <Campo tipo="texto" etiqueta="Motivo de ingreso sin tag temporal" name="motivo_sin_tag" condicion_entrega_tag="No" obligatorio="true"/>
    <Descripcion><p>Se registra un préstamo temporal. La entrega permanente de tags corresponde a otro proceso.</p></Descripcion>
  </Grupo>
  <Grupo nombre="Salida física" condicion_operacion="salida">
    <Campo tipo="checklist" catalogo="personas_dentro" etiqueta="¿Qué personas salen?" name="personas_salen" condicion_ingreso_id="!sin_ingreso" obligatorio="true"/>
    <Campo tipo="si_no" etiqueta="¿Sale también el vehículo?" name="vehiculo_sale" condicion_vehiculo_dentro="Sí" obligatorio="true"/>
    <Campo tipo="si_no" etiqueta="¿Se devuelve el tag temporal?" name="devolvio_tag" condicion_tenia_tag="Sí" obligatorio="true"/>
    <Campo tipo="texto" etiqueta="Incidencia / seguimiento del tag" name="incidencia_tag" condicion_tenia_tag="Sí" condicion_devolvio_tag="No" obligatorio="true"/>
    <Campo tipo="texto" etiqueta="Incidencias de la salida (opcional)" name="incidencias"/>
    <Campo tipo="si_no" etiqueta="¿El movimiento físico ya ocurrió sin respaldo completo?" name="hechos_ocurridos" condicion_tipo_salida="!Salida normal" obligatorio="true"/>
    <Campo tipo="texto" etiqueta="Describe los hechos y la incidencia; esto no autoriza el movimiento" name="incidencia_hechos" condicion_hechos_ocurridos="Sí" obligatorio="true"/>
  </Grupo>
  <Grupo nombre="Atención" condicion_operacion="emergencia" condicion_emergencia_activa="Sí">
    <Campo tipo="texto" etiqueta="Unidad / corporación (puede completarse después)" name="unidad"/>
    <Campo tipo="texto" etiqueta="Responsable de la atención (opcional)" name="responsable_emergencia"/>
    <Campo tipo="texto" etiqueta="Situación y atención registrada (opcional)" name="atencion"/>
  </Grupo>
  <Grupo nombre="Cierre"><Campo tipo="texto" etiqueta="Observaciones (opcional)" name="observaciones"/></Grupo>
  <Validaciones>
    <Regla operador="direcciones_validas" mensaje="Revisa el coto, la calle y el número seleccionados."/>
    <Regla operador="alcance_calle" accion="entrada|llamada" mensaje="Toda la calle solo corresponde a trabajos o servicios. Cambia el asunto o delimita los domicilios."/>
    <Regla operador="campos_obligatorios" mensaje="Completa las preguntas obligatorias visibles."/>
    <Regla operador="destinos_unicos" mensaje="Elimina el destino duplicado."/>
    <Regla operador="referencias_validas" mensaje="El ingreso u objeto seleccionado ya no está disponible."/>
    <Regla operador="tag_disponible" accion="entrada" mensaje="Ese tag ya está prestado. Selecciona otro."/>
    <Regla operador="identidad_verificada" accion="entrada" mensaje="Identificación o relación residencial pendiente de revisión."/>
    <Regla operador="alcance_autorizado" accion="entrada|salida_especial" mensaje="No hay destinos autorizados o falta confirmar el alcance limitado."/>
    <Regla operador="formatos_muebles" accion="entrada|salida_especial" mensaje="Falta un formato verificado por domicilio de origen. El movimiento permanece pendiente."/>
    <Regla operador="receptor_verificado" accion="objeto" mensaje="Verifica al receptor antes de entregar o devolver."/>
  </Validaciones>
  <Acciones>
    <Accion id="pendiente" etiqueta="Guardar pendiente" condicion_operacion="entrada|salida|llamada"/>
    <Accion id="denegacion" etiqueta="Registrar denegación" condicion_operacion="entrada|salida|llamada"/>
    <Accion id="entrada" etiqueta="Confirmar entrada" condicion_operacion="entrada"/>
    <Accion id="entrada" etiqueta="Confirmar entrada ordinaria" condicion_operacion="emergencia" condicion_emergencia_activa="No"/>
    <Accion id="salida" etiqueta="Confirmar salida" condicion_operacion="salida"/>
    <Accion id="hechos" etiqueta="Registrar salida física e incidencia" condicion_operacion="salida" condicion_hechos_ocurridos="Sí"/>
    <Accion id="llamada" etiqueta="Registrar llamada simulada" condicion_operacion="llamada"/>
    <Accion id="objeto" etiqueta="Registrar recepción / entrega" condicion_operacion="objetos"/>
    <Accion id="emergencia" etiqueta="Registrar atención de emergencia" condicion_operacion="emergencia" condicion_emergencia_activa="Sí"/>
  </Acciones>
  <Criterios><Criterio>Una autorización precede a la entrada física.</Criterio><Criterio>El alcance se verifica por destino; Todo este coto no cubre otros cotos.</Criterio><Criterio>Salida física, tag y objeto tienen estados independientes.</Criterio></Criterios>
  <Comunicaciones modo="simulado" solicitud_en="destinos_listos" publicacion_en="movimiento_registrado">
    <Perfil tipo_persona="Visita" datos="completo_operativo"/>
    <Perfil tipo_persona="Repartidor / paquetería" datos="parcial"/>
    <Politica privacidad="identificacion_no_publicar"/>
    <Politica alcance="solicitud_solo_destino_propio"/>
  </Comunicaciones>
</ChecklistAccesos>
